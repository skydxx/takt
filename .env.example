APP_ENV=development
BOT_TOKEN=
FLASK_SECRET_KEY=
# Independent Flask signing key for the admin container. Required in production.
ADMIN_FLASK_SECRET_KEY=
# Admin auth cookie name; keep it different from the public session cookie.
ADMIN_SESSION_COOKIE_NAME=admin_session_token
WEB_PORT=5000
# Public and admin are separate WSGI apps/processes (web_app.py / admin_app.py
# — see docker-compose.example.yml). ADMIN_WEB_PORT is the admin process's own
# port; it should never be published directly to the internet, only reached
# through a reverse proxy terminating ADMIN_HOST.
ADMIN_WEB_PORT=5001
# Interface the admin process binds to. Defaults to 127.0.0.1 (unreachable
# from outside its own host/container — the safe default). Only set this to
# 0.0.0.0 when a reverse proxy in a separate container needs to reach it over
# a docker network, as in docker-compose.example.yml.
ADMIN_BIND_HOST=127.0.0.1
# Optional: TLS served directly by the admin process instead of terminated by
# a reverse proxy. Falls back to SSL_CERT/SSL_KEY if unset.
ADMIN_SSL_CERT=
ADMIN_SSL_KEY=
DOMAIN=localhost
# Dedicated host for the admin app's own surface (/admin*, /owner*,
# /backups*, and its /login, /logout, /). Leave empty for local dev (no host
# isolation — admin_app.py serves any host). In production, point it at a
# separate hostname/DNS record — e.g. admin.example.com — served over HTTPS;
# a request on any other host is redirected or rejected. This is
# defense-in-depth *inside* the admin process; the primary boundary is that
# the public process (web_app.py) never imports these routes at all — see
# docs/security-baseline.md.
ADMIN_HOST=
# Overrides the legacy SQLite bot DB path (default: alongside the code). Set
# this when the public and admin containers need to point at a shared
# volume path outside either image's own code directory, e.g. /app/data/salary_bot.db.
DATABASE_PATH=
PLATFORM_DATABASE_PATH=platform.db
# Production PostgreSQL DSN, for example:
# PLATFORM_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tochka_smena
PLATFORM_DATABASE_URL=
VPN_ENABLED=0
OWNER_TELEGRAM_ID=
ERROR_NOTIFICATION_USER_ID=
CURATOR_CHAT_ID=
SUPER_ADMIN_1=
SUPER_ADMIN_2=
SUPER_ADMIN_3=
SUPER_ADMIN_4=
SUPER_ADMIN_5=
